<?xml version="1.0" encoding="utf-8"?>
<xml mode="jtbc" author="jetiben">
  <configure>
    <node>item</node>
    <field>name,zh-cn</field>
    <base>item_list</base>
  </configure>
  <item_list>
    <item>
      <name><![CDATA[text-tit-addField]]></name>
      <zh-cn><![CDATA[添加新字段]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-tit-editField]]></name>
      <zh-cn><![CDATA[编辑字段]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-tit-edit-mode-1]]></name>
      <zh-cn><![CDATA[直接修改字段配置]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-tit-edit-mode-2]]></name>
      <zh-cn><![CDATA[通过向导重新配置]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-tit-config]]></name>
      <zh-cn><![CDATA[模块基本设置]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-tit-rename]]></name>
      <zh-cn><![CDATA[模块重命名]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-search-placeholder]]></name>
      <zh-cn><![CDATA[关键词筛选]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-tips-config-1]]></name>
      <zh-cn><![CDATA[当前的模块名不可修改]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-tips-config-2]]></name>
      <zh-cn><![CDATA[请注意，如果是对一个刚添加的模块重命名，这通常没有什么副作用。但由于模块名有时候直接决定了访问路径，因此对于已经对外的模块进行重命名操作将可能影响正常访问，请自行评估影响范围和变更链接地址。]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-submit-config]]></name>
      <zh-cn><![CDATA[保存设置]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-submit-rename]]></name>
      <zh-cn><![CDATA[确认操作]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-4000]]></name>
      <zh-cn><![CDATA[字段类型和格式校验不能为空]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-4001]]></name>
      <zh-cn><![CDATA[该模块不允许被设置]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-4002]]></name>
      <zh-cn><![CDATA[该模块不存在指定的数据库表名]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-4003]]></name>
      <zh-cn><![CDATA[字段名必须是英文数字和连字符的组合]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-4004]]></name>
      <zh-cn><![CDATA[字段名已经存在]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-4005]]></name>
      <zh-cn><![CDATA[字段名不存在]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-4006]]></name>
      <zh-cn><![CDATA[字段配置不是有效的JSON格式]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-config-4001]]></name>
      <zh-cn><![CDATA[模块不存在]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-config-4444]]></name>
      <zh-cn><![CDATA[保存失败，请检查服务器文件权限]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4001]]></name>
      <zh-cn><![CDATA[模块名只能是字母数字和连字符的格式]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4002]]></name>
      <zh-cn><![CDATA[模块名并未修改]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4004]]></name>
      <zh-cn><![CDATA[该模块不可被重命名]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4005]]></name>
      <zh-cn><![CDATA[模块名对应的目录已经存在]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4006]]></name>
      <zh-cn><![CDATA[该模块含有不符合规范的数据库表名]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4007]]></name>
      <zh-cn><![CDATA[模块名对应的父模块并不是一个有效的父模块]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4008]]></name>
      <zh-cn><![CDATA[服务器文件目录重命名失败，请检查目录权限]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4010]]></name>
      <zh-cn><![CDATA[在对数据库表进行重命名时发生异常]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[text-code-rename-4444]]></name>
      <zh-cn><![CDATA[保存失败，请检查服务器文件权限]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[log-addField]]></name>
      <zh-cn><![CDATA[在表[{$[tableName]}]中添加新字段[{$[fieldName]}]成功]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[log-editField]]></name>
      <zh-cn><![CDATA[在表[{$[tableName]}]中修改字段[{$[fieldName]} => {$[newFieldName]}]成功]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[log-dropField]]></name>
      <zh-cn><![CDATA[在表[{$[tableName]}]中删除字段[{$[fieldName]}]成功]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[log-orderField]]></name>
      <zh-cn><![CDATA[在表[{$[tableName]}]中对字段[{$[fieldName]}]排序成功]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[log-config]]></name>
      <zh-cn><![CDATA[修改模块[{$[genre]}]的基本设置成功]]></zh-cn>
    </item>
    <item>
      <name><![CDATA[log-rename]]></name>
      <zh-cn><![CDATA[将模块[{$[genre]}]重命名为[{$[targetGenre]}]成功]]></zh-cn>
    </item>
  </item_list>
</xml>